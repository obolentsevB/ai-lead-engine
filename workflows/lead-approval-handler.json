    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst SECRET = $env.APPROVAL_SECRET;\nif (!SECRET) throw new Error('APPROVAL_SECRET is not configured');\n\nreturn $input.all().map(item => {\n  const q = item.json.body ?? item.json.query ?? {};\n  const sid    = String(q.sid ?? '');\n  const exp    = Number(q.exp ?? 0);\n  const sig    = String(q.sig ?? '');\n  const action = String(q.action ?? '');\n\n  const fail = (reason) => ({ json: { ok: false, reason, sid, action } });\n\n  if (!sid || !exp || !sig)                 return fail('missing parameters');\n  if (!['send', 'hold'].includes(action))   return fail('unknown action');\n\n  const expected = crypto\n    .createHmac('sha256', SECRET)\n    .update(`${sid}.${exp}`)\n    .digest('hex');\n\n  let valid = false;\n  try {\n    valid = crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(sig));\n  } catch { valid = false; }\n\n  if (!valid)              return fail('invalid signature');\n  if (Date.now() > exp)    return fail('link expired');\n\n  return { json: { ok: true, sid, action, exp } };\n});"
      },
