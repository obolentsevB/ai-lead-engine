    {
      "parameters": {
        "jsCode": "const v = $('Verify Token').first().json;\nconst rows = $input.all().filter(i => i.json.submission_id);\n\nif (rows.length === 0) {\n  return [{ json: { status: 'not_found', sid: v.sid } }];\n}\n\nconst lead = rows[0].json;\n\nif (lead.action_taken === 'email_sent') {\n  return [{ json: { status: 'already_sent', ...lead } }];\n}\nif (lead.action_taken === 'on_hold' && v.action === 'hold') {\n  return [{ json: { status: 'already_held', ...lead } }];\n}\n\nreturn [{ json: {\n  status: v.action === 'send' ? 'proceed_send' : 'proceed_hold',\n  action: v.action,\n  ...lead,\n}}];"
      },
