    {
      "parameters": {
        "jsCode": "const v = $('Verify Token').first().json;\n\nlet s = {};\ntry {\n  s = $('Check State').first().json ?? {};\n} catch {\n  s = {};\n}\n\nlet title, body, color;\n\nif (!v.ok) {\n  title = 'Link not valid';\n  body  = v.reason === 'link expired'\n    ? 'This approval link has expired. Open the lead in Slack for a fresh one.'\n    : 'This link could not be verified.';\n  color = '#b91c1c';\n} else if (s.status === 'already_sent') {\n  title = 'Already sent';\n  body  = 'A reply was already sent to this lead. No second email was sent.';\n  color = '#b45309';\n} else if (s.status === 'not_found') {\n  title = 'Lead not found';\n  body  = 'No lead matches this link.';\n  color = '#b91c1c';\n} else if (v.action === 'hold') {\n  title = 'Put on hold';\n  body  = 'No email was sent. The lead stays in the queue.';\n  color = '#0369a1';\n} else {\n  title = 'Sent';\n  body  = `Reply delivered to ${s.email ?? 'the lead'}.`;\n  color = '#15803d';\n}\n\nconst html = `<!doctype html>\n<html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>${title}</title></head>\n<body style=\"font-family:system-ui,-apple-system,sans-serif;background:#f6f7f9;margin:0;padding:48px 16px\">\n  <div style=\"max-width:420px;margin:0 auto;background:#fff;border-radius:12px;padding:32px;box-shadow:0 1px 3px rgba(0,0,0,.08)\">\n    <h1 style=\"margin:0 0 12px;font-size:20px;color:${color}\">${title}</h1>\n    <p style=\"margin:0;color:#374151;line-height:1.5\">${body}</p>\n  </div>\n</body></html>`;\n\nreturn [{ json: { html } }];"
      },
