# Copy this file to .env and fill in real values.
# Generate secrets with: openssl rand -hex 32

# --- Host ---
N8N_HOST=n8n.example.com
N8N_PUBLIC_URL=https://n8n.example.com

# --- Database ---
# openssl rand -hex 24
POSTGRES_PASSWORD=replace_me

# --- n8n ---
# openssl rand -hex 32
# WARNING: losing this key makes every stored credential unreadable.
# Save it in a password manager before the first start.
N8N_ENCRYPTION_KEY=replace_me

# --- Approval links ---
# openssl rand -hex 32
# Signs the Approve/Hold URLs sent to Slack.
APPROVAL_SECRET=replace_me

# --- Form webhook ---
# From Tally: Integrations -> Webhooks -> Signing secret
TALLY_SIGNING_SECRET=replace_me
